# Copy to .env only after generating independent keys and reviewing every setting.
DIFOUNDRY_ENV=production
DIFOUNDRY_DATABASE_URL=postgresql+psycopg://difoundry:CHANGE_ME@postgres:5432/difoundry

# Generate each with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DIFOUNDRY_TOKEN_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
DIFOUNDRY_VAULT_KEYS={"1":"REPLACE_WITH_DIFFERENT_32_BYTE_BASE64_KEY"}
DIFOUNDRY_VAULT_ACTIVE_KEY_VERSION=1
DIFOUNDRY_AUDIT_ANCHOR_KEY=REPLACE_WITH_THIRD_32_BYTE_BASE64_KEY
DIFOUNDRY_AUDIT_ANCHOR_PATH=/var/lib/difoundry-audit/anchors

DIFOUNDRY_TOKEN_ISSUER=difoundry-production
DIFOUNDRY_TOKEN_TTL=3600

# Closed by default. For first boot, set true temporarily AND supply a random,
# out-of-band bootstrap token. Disable it immediately after bootstrap.
DIFOUNDRY_BOOTSTRAP_ENABLED=false
# DIFOUNDRY_BOOTSTRAP_TOKEN=REPLACE_WITH_ONE_TIME_RANDOM_TOKEN

DIFOUNDRY_CORS_ORIGINS=https://foundry.example.com
# Only immediate reverse-proxy networks belong here. Never use 0.0.0.0/0.
DIFOUNDRY_TRUSTED_PROXY_CIDRS=172.16.0.0/12
DIFOUNDRY_MAX_REQUEST_BYTES=2000000
DIFOUNDRY_RATE_LIMIT_PER_MINUTE=180
DIFOUNDRY_LOGIN_LOCKOUT_THRESHOLD=8
DIFOUNDRY_LOGIN_LOCKOUT_SECONDS=900
